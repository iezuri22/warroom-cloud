{
  "rewrites": [
    { "source": "/", "destination": "/daily-planner.html" },
    { "source": "/api/health-chat", "destination": "/api/assistant?mode=health" },
    { "source": "/api/plan-chat", "destination": "/api/assistant?mode=plan" }
  ],
  "crons": [
    { "path": "/api/ecm-deadline-reminders", "schedule": "0 13 * * *" }
  ],
  "functions": {
    "api/assistant.js": { "maxDuration": 60 }
  },
  "headers": [
    {
      "source": "/(.*)\\.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/sync-client.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ]
}
